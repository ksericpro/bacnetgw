# Copy to .env to configure environment overrides without editing config.yaml
GATEWAY_ID=zaarr-bacnet-gw-01
SITE_NAME="Smart Nation Exhibition System"
LOG_LEVEL=info

# Network / Subnet settings (auto-detects all subnets when empty, or lock to e.g. 192.168.0.0/24)
BACNET_SUBNET=
BACNET_INTERFACE=
BACNET_BIND_IP=0.0.0.0
BACNET_PORT=47808
BACNET_REUSE_PORT=true

# Polling & Production Catalog settings
BACNET_DISCOVERY_INTERVAL_SEC=60
BACNET_POLL_INTERVAL_SEC=5
BACNET_SUBSCRIBE_COV=true
BACNET_ONLY_CATALOG_POINTS=true
BACNET_FORWARD_PACKET_EVENTS=false

# External IMOPS API settings (set IMOPS_ENABLED=true when ready to push to IMOPS)
IMOPS_ENABLED=false
IMOPS_BASE_URL=https://api.imops.example.com
IMOPS_TELEMETRY_PATH=/api/v1/bacnet/telemetry
IMOPS_DEVICES_PATH=/api/v1/bacnet/devices
IMOPS_PACKET_EVENTS_PATH=/api/v1/bacnet/packets
IMOPS_AUTH_TYPE=basic
IMOPS_USERNAME=your-imops-username
IMOPS_PASSWORD=your-imops-password
IMOPS_LOGIN_PATH=/api/v1/auth/login
IMOPS_BEARER_TOKEN=
IMOPS_API_KEY_HEADER=X-API-Key
IMOPS_API_KEY=
